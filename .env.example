# Скопируйте этот файл в .env (рядом с местом запуска `python -m agents_core.main`)
# и настройте под себя. Значения считываются один раз при старте процесса —
# перезапустите сервис, чтобы подхватить изменения.

AGENT_HOST=0.0.0.0
AGENT_PORT=8000
AGENT_DB_PATH=agents_core.db

# Какие провайдеры активны. Провайдер, не перечисленный здесь, не
# опрашивается при старте, даже если для него ниже заданы прочие переменные.
PROVIDERS=deepseek,ollama

# --- DeepSeek (облачный провайдер) ------------------------------------------
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro,deepseek-v4-flash-vision-exp

# --- Ollama (локальные модели) ----------------------------------------------
# https://docs.ollama.com/api/ — сервер должен быть запущен отдельно
# (`ollama serve`), а перечисленные модели — заранее загружены (`ollama pull qwen3:0.6b`).
OLLAMA_BASE_URL=http://localhost:11434
# По умолчанию предложена компактная qwen3:0.6b — её реально запускать даже
# без GPU. Ниже перечислены и другие размеры семейства qwen3 для локального
# запуска; список редактируется под то, что реально загружено в Ollama.
OLLAMA_MODELS=qwen3:0.6b,qwen3:1.7b,qwen3:4b,qwen3:8b,qwen3:14b,qwen3:30b-a3b

# --- Реестр скиллов для профилей-пайплайнов --------------------------------
# JSON-массив описаний функций в формате OpenAI function-tool — то, из чего
# можно собрать профиль ПО ИМЕНИ (`skill_names` в POST/PUT .../profiles),
# не переписывая вручную JSON-схему функции. Регистрация здесь делает скилл
# видимым и выбираемым в приложении/API — она НЕ создаёт реализацию сама
# по себе: что функция реально делает при вызове, по-прежнему фиксировано
# в коде (agents_core/repository.py, Repository._TOOL_HANDLERS), так что
# список ниже должен оставаться подмножеством того, что сервис реально умеет
# выполнять. По умолчанию пусто (ничего не зарегистрировано). Пример ниже —
# три демо-скилла "Покупки" (agents_core/skills/shopping_demo.py):
# search_products/add_to_cart/view_cart.
AGENT_REGISTERED_SKILLS=[{"type": "function", "function": {"name": "search_products", "description": "Найти товары в каталоге демо-магазина по названию/категории и опционально по максимальной цене.", "parameters": {"type": "object", "properties": {"query": {"type": "string", "description": "Строка поиска по названию или категории товара"}, "max_price": {"type": "number", "description": "Верхняя граница цены (опционально)"}}, "required": []}}}, {"type": "function", "function": {"name": "add_to_cart", "description": "Добавить товар по его id в корзину текущего чата.", "parameters": {"type": "object", "properties": {"product_id": {"type": "string", "description": "id товара из результата search_products"}}, "required": ["product_id"]}}}, {"type": "function", "function": {"name": "view_cart", "description": "Показать текущее содержимое корзины текущего чата и итоговую сумму.", "parameters": {"type": "object", "properties": {}, "required": []}}}]

# --- "Менеджер задач": system prompt по шаблону -----------------------------
# Подмешивается, пока у чата включена настройка "Отслеживать задачи"
# (task_tracking_enabled). По умолчанию используется встроенный текст
# шаблона (см. agents_core/config.py: DEFAULT_TASK_TRACKING_PROMPT_TEMPLATE) —
# раскомментируйте и отредактируйте строку ниже, только если нужен другой
# текст. Внутри шаблона обязательны плейсхолдеры <task_states></task_states>
# и <task_state_machine_invariants></task_state_machine_invariants> — сервис
# сам подставляет туда, соответственно, список состояний машины (из кода) и
# тексты инвариантов категории "Правило стейт-машины", привязанных к машине
# (экран "Модели состояний задач"), по одному на строку. Поскольку простой
# загрузчик .env ниже не поддерживает многострочные значения, перевод строки
# внутри значения нужно писать как ДВА символа "\n" (обратный слеш + n) —
# они разворачиваются обратно в реальный перевод строки при чтении.
# TASK_TRACKING_PROMPT_TEMLATE=Если в переписке появляется задача/задачи возвращай со следующими параметрами:\ntask - Название задачи,\nstate - Этап конечного автомата - TaskState,\nstep - Целое от 1 до 4, в соответствии с перечнем TaskState,\ntotal - Целое число, всего шагов (4 в соответствии с TaskState),\nplan - Утверждённый план, список ["", ..],\ndone - Что уже сделано, список ["", ..],\ncurrent - Что делаем сейчас.\nTaskState: <task_states></task_states>\nВ дальнейшем при работе в этом диалоге соблюдай следующие правила:\n[TASK STATE MACHINE INVARIANTS]\n<task_state_machine_invariants></task_state_machine_invariants>\nПри ответе на запрос, предлагай информацию по задаче (в описанном выше формате), промежуточный или конечный результат (если задача выполнена) и в соответствии с требованиями правил (TASK STATE MACHINE INVARIANTS) запрашивай подтверждение пользователем на продолжение работы.

# --- Логирование -------------------------------------------------------
# Каждый входящий REST-запрос (agents_core.access) и каждый исходящий
# вызов внешнего API LLM (agents_core.llm.deepseek / agents_core.llm.ollama)
# логируется одной строкой в stderr, с параметрами вызова. Уровень:
# DEBUG/INFO/WARNING/ERROR.
AGENT_LOG_LEVEL=INFO
# Путь к файлу лога В ДОПОЛНЕНИЕ к stderr (ротация по 10 МБ, храним 3
# последних файла). Пусто по умолчанию — лог только в stderr.
AGENT_LOG_FILE=
# Сколько символов тела запроса/ответа или JSON-параметров вызова
# показывать в одной строке лога (длинные тела сообщений чата иначе делают
# лог нечитаемым) — остальное усекается с пометкой исходной длины.
AGENT_LOG_BODY_LIMIT=2000

# --- MCP-сервер (третий, отдельно разворачиваемый компонент) ----------------
# AgentsCore подключается к нему КАК MCP-КЛИЕНТ по Streamable HTTP — список
# инструментов дописывается к своим (памяти/задач/скиллов) в каждом запросе
# к модели, а вызов инструмента, которого нет среди своих обработчиков, но
# который есть в этом списке, уходит на MCP-сервер. Полностью необязательно:
# по умолчанию выключено, существующие развёртывания без MCP-сервера не
# затрагиваются — недоступность MCP-сервера тоже не ломает обычный чат
# (используется кэш последнего успешного списка инструментов, см.
# agents_core/mcp_client.py).
MCP_ENABLED=false
# Адрес MCP-эндпоинта ЦЕЛИКОМ (со своим путём, обычно /mcp), например:
# MCP_SERVER_URL=http://mcp:8001/mcp
# Если указать базовый адрес без /mcp (например, тот же адрес, что и для
# REST API AgentsApp: http://mcp:8001/) — AgentsCore сам допишет /mcp (см.
# mcp_client.normalize_mcp_base_url); но лучше сразу указывать полный адрес.
MCP_SERVER_URL=
# Несколько MCP-серверов — «имя=адрес» через запятую; если задано, используется
# вместо MCP_SERVER_URL. Например, сервер инструментов и планировщик (его
# инструменты schedule_job/list_jobs/cancel_job позволяют агенту самому ставить
# задачи по расписанию):
# MCP_SERVERS=tools=http://localhost:8001/mcp,scheduler=http://localhost:8002/mcp
MCP_SERVERS=
# Заготовка под будущую аутентификацию к MCP-серверу — пока ничего не
# проверяет (см. mcp_server/.env.example, тот же принцип на другой стороне).
# Файл описания MCP-серверов (JSON) — для внешних серверов, например GitHub MCP:
# у каждого сервера свой адрес (как есть), свои заголовки (${ПЕРЕМЕННЫЕ} из
# окружения) и подпись title. Если задан — используется ВМЕСТО MCP_SERVERS и
# MCP_SERVER_URL (перечислите в нём и серверы продукта). Пример —
# mcp_servers.example.json.
MCP_SERVERS_FILE=
# Токен для примера с GitHub MCP (подставляется в заголовок из файла выше).
GITHUB_MCP_TOKEN=
MCP_API_KEY=
# Таймаут запросов к MCP-серверу (секунды).
MCP_REQUEST_TIMEOUT=180

# --- Асинхронные запуски ------------------------------------------------------
# Сколько ответов модели выполняется одновременно (в разных чатах; в одном
# чате — всегда не больше одного).
AGENT_RUN_WORKERS=4
# Предельное время одного запуска, секунды.
AGENT_RUN_TIMEOUT=600
# Сколько секунд лента событий завершённого запуска хранится в памяти.
AGENT_RUN_EVENTS_TTL=600
# Сколько дней хранятся записи о завершённых запусках.
AGENT_RUN_RETENTION_DAYS=30
